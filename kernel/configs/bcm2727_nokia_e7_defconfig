# Minimal kernel config for the Nokia E7-00 on BCM2727B1 (RAPU), ARM1176.
#
# Stage 2 bring-up: pinctrl/GPIO + root interrupt controller (ICU) + OS
# timer, all decoded from the Symbian ROM (docs/bcm2727-icu-timer.md).
# Boots through the QEMU NLoader chain with self-calibrated lpj; on
# hardware the remaining blockers are the UART console and storage.
#
# Build:
#   make ARCH=arm CROSS_COMPILE=arm-linux-gnueabihf- bcm2727_nokia_e7_defconfig
#   make ARCH=arm CROSS_COMPILE=arm-linux-gnueabihf- -j$(nproc) zImage dtbs

CONFIG_BLK_DEV_INITRD=y
CONFIG_KALLSYMS_ALL=y

CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V6=y
# keep it single-platform so the build stays quick
# CONFIG_ARCH_MULTI_V7 is not set
CONFIG_ARCH_BCM=y
CONFIG_ARCH_BCM2727=y

CONFIG_HIGHMEM=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
# CONFIG_CMDLINE is not set
# CONFIG_CMDLINE_EXTEND is not set

CONFIG_VFP=y
# ARM1176JZF-S has no NEON
# CONFIG_NEON is not set

# Console: the BCM2727 UART base is not decoded yet, so no uart node exists
# in the DTS.  PL011 is enabled purely for QEMU chain boot (earlycon=pl011
# against the QEMU-only console at 0x40100000); it matches nothing on
# hardware and is harmless there.
CONFIG_ARM_AMBA=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# Hardware console (task 100): TX bit-bang on genio42 ("TxCDa"), timed
# against the OS-timer frc counter; /dev/ttySU0 + earlycon=bcm2727su.
CONFIG_SERIAL_BCM2727_SOFTUART=y
CONFIG_SERIAL_BCM2727_SOFTUART_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

CONFIG_PINCTRL_BCM2727=y
CONFIG_GPIO_SYSFS=y
CONFIG_DEBUG_FS=y

# Stage 3 (task 097): Rapu_Memcard storage + initramfs shell
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BCM2727=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
# Stage 4 (task 099): gpio irqchain validation module (insmod on the eMMC root)
CONFIG_GPIO_BCM2727_TEST=m

# Stage 5 (task 113): I2C masters — i2cdetect/i2cget against the modeled
# bus citizens (charger 0x6B bus 2, PMIC echoes 0x48-0x4B bus 0)
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_BCM2727=y

# Stage 6 (task 123): MUSBHDRC USB host (sys+0x8800, ICU 183 core line)
# + mass storage (usb-storage/SCSI) + HIDBP keyboard + FAT for the
# usb-storage round-trip validation.  PIO only: the BCM HSDMA channel
# order differs from mainline musbhsdma and is not driven.
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_HOST=y
CONFIG_USB_MUSB_BCM2727=y
CONFIG_MUSB_PIO_ONLY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_INPUT=y
CONFIG_USB_KBD=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# Stage 7 (task 126): MeSSI VCHI transport driver for the VideoCore
# display arc (/dev/bcm2727-vchi, docs/bcm2727-display-recon.md §11.6/
# §12).  IRQ-driven (ICU 201); poll=1 module param is the fallback.
CONFIG_BCM2727_VCHI=y
