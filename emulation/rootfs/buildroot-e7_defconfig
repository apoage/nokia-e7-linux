# Nokia E7-00 buildroot rootfs — task 103
#
# ARMv6 (ARM1176JZF-S) soft-float userland on musl, built with the
# musl.cc armv6-linux-musleabi cross gcc (gcc 11.2, kernel headers
# 5.15) as an EXTERNAL custom toolchain.  The toolchain dir and the
# rootfs overlay dir are host-absolute paths injected at configure
# time by build-buildroot-root.sh (make VAR=... olddefconfig), so this
# defconfig stays machine-independent.
#
# ABI note: the toolchain is EABI soft-float — same ABI as the Debian
# armel busybox that carried tasks 097-102.  BR2_ARM_SOFT_FLOAT is set
# so buildroot's config agrees with what the compiler actually is
# (arm1176jzf-s would otherwise default the *internal* flags to
# EABIhf; with an external toolchain the gcc's own default (soft)
# governs, but keep the config honest anyway).
BR2_arm=y
BR2_arm1176jzf_s=y
BR2_ARM_EABI=y
BR2_ARM_SOFT_FLOAT=y

# Toolchain: external custom musl (musl.cc armv6-linux-musleabi-cross)
BR2_TOOLCHAIN=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
# BR2_TOOLCHAIN_EXTERNAL_PATH injected by build-buildroot-root.sh
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="armv6-linux-musleabi"
BR2_TOOLCHAIN_EXTERNAL_GCC_11=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_NAME="musl.cc armv6 soft-float"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_15=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
# musl.cc crosses ship a working gfortran + libgomp; buildroot's
# sanity checks demand the config declares what the toolchain can do.
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y

# ARMv6 codegen: BR2_arm1176jzf_s makes buildroot's gcc wrapper pass
# -mcpu=arm1176jzf-s to every package build (no explicit march needed —
# layering one on top conflicts with the -mcpu).

# System: busybox init, our overlay replaces inittab/rcS with the E7
# boot banner (parity with the task-098 root).
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_TARGET_GENERIC_HOSTNAME="nokia-e7"
BR2_TARGET_GENERIC_ISSUE="Nokia E7-00 — Linux on BCM2727B1 (ARMv6 musl)"
BR2_SYSTEM_DHCP=""

# Packages: on-device debugging + the I2C toolset for the upcoming
# sys+0x22/23/25xx master decode (desk queue item 2).  SHOW_OTHERS:
# i2c-tools is hidden while busybox's own i2c applets are around.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_STRACE=y

# Image: 64 MiB ext4 (power of two — QEMU sd.c CSD rule, task 101),
# no partition table, boots as /dev/mmcblk0 via build-emmc-root flow.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="64M"
# BR2_TARGET_ROOTFS_TAR is not set
